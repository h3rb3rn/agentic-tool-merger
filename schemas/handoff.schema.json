{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sessionmesh.dev/schemas/handoff/1.0",
  "title": "SessionMesh Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "global_session_id",
    "objective",
    "status",
    "decisions",
    "completed",
    "open_tasks",
    "repository",
    "tests",
    "relevant_files",
    "next_action",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "global_session_id": { "type": "string", "pattern": "^gs_[A-Za-z0-9_-]+$" },
    "objective": { "type": "string", "minLength": 1 },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "completion"],
      "properties": {
        "phase": { "type": "string", "minLength": 1 },
        "completion": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "decisions": { "$ref": "#/$defs/nonEmptyStrings" },
    "completed": { "$ref": "#/$defs/nonEmptyStrings" },
    "open_tasks": { "$ref": "#/$defs/nonEmptyStrings" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "head", "dirty"],
      "properties": {
        "branch": { "type": ["string", "null"] },
        "head": { "type": ["string", "null"] },
        "dirty": { "type": "boolean" }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "failing"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "failing": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "relevant_files": { "$ref": "#/$defs/nonEmptyStrings" },
    "next_action": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "field"],
        "properties": {
          "event_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "field": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
