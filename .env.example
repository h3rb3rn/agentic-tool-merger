# SessionMesh state and local service
SESSIONMESH_HOME=/var/lib/sessionmesh
SESSIONMESH_BIND_ADDRESS=127.0.0.1
SESSIONMESH_PORT=8787
SESSIONMESH_ALLOW_NETWORK=false
SESSIONMESH_WEB_ROOT=/usr/share/sessionmesh/web

# Persistence
SESSIONMESH_DATABASE_PATH=/var/lib/sessionmesh/sessionmesh.db
SESSIONMESH_BLOB_STORE_PATH=/var/lib/sessionmesh/blobs

# Ingestion and privacy
SESSIONMESH_WATCH_DEBOUNCE_MS=750
SESSIONMESH_REDACTION_ENABLED=true

# Optional local OpenAI-compatible model endpoints.
# Leave empty until explicitly configured. Never commit API keys or tokens.
SESSIONMESH_EMBEDDING_ENDPOINT=
SESSIONMESH_LLM_ENDPOINT=
SESSIONMESH_MODEL=
SESSIONMESH_TOKEN_BUDGET=4000
SESSIONMESH_CORRELATION_THRESHOLD=0.8

# Host home used only by Compose interpolation. The container mount is
# read-only; prefer a dedicated directory containing only agent profiles when
# the complete home is not required.
SESSIONMESH_AGENT_HOME=${HOME}
